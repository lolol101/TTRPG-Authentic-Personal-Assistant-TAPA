# OpenAI-compatible endpoint. Both OpenRouter (cloud, current default) and
# Ollama (local, needs a GPU-capable machine) work here — swap these three
# values, no code changes needed.

# OpenRouter (get a free key at https://openrouter.ai/keys):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-api-key
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Ollama, once running on a GPU machine, would instead be:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b-instruct
