# OpenAI-compatible endpoints. Ollama (local, GPU) and OpenRouter (cloud) both
# speak this API — swap the values, no code changes needed.

# Primary provider:
LLM_PROVIDER_LABEL=ollama-local
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:14b

# GigaChat speaks a dialect of this API, not the API itself: tools have to be
# sent as functions, and a short-lived token is minted from Basic credentials
# instead of a static key (see app/core/gigachat.py). To use it as primary:
#
#   LLM_PROVIDER_LABEL=gigachat
#   LLM_BASE_URL=https://api.giga.chat/v1
#   LLM_DIALECT=gigachat
#   LLM_API_KEY=
#   LLM_AUTH_KEY=<Authorization key из личного кабинета, строка base64>
#   LLM_MODEL=GigaChat-3-Ultra
#
# Its endpoints are signed by the Russian state CA; the roots ship in
# certs/ and are trusted for this provider only. LLM_CA_BUNDLE overrides.

# Fallback, used only when the primary is unreachable (machine off, network
# down). Leave LLM_FALLBACK_API_KEY empty to disable falling back.
LLM_FALLBACK_PROVIDER_LABEL=openrouter
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Embeddings: "ollama" runs on the GPU, "fastembed" is the CPU-only fallback.
# Each model has its own vector space, so each gets its own Chroma collection;
# ingest into both if you want retrieval to survive the fallback.
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL_ID=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_FALLBACK_BACKEND=fastembed
EMBEDDING_FALLBACK_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Retrieval. The rulebooks are English, so a question in any other language is
# first restated in the book's own terms and searched under both phrasings.
# Costs one extra completion and one extra embedding per ordinary question;
# set to false to go back to the single plain search.
RETRIEVAL_REWRITE_QUERY=true
