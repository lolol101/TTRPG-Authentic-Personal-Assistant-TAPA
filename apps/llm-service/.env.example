# Point this at the Ollama host: http://<lan-ip>:11434/v1 for a remote GPU
# machine (run `ollama serve` there with OLLAMA_HOST=0.0.0.0), or leave as
# localhost if Ollama runs on this machine.
OLLAMA_BASE_URL=http://localhost:11434/v1
# gpt-oss:20b: MoE, ~3.6B active params, built for local agentic/tool-calling
# use within 16GB VRAM. `ollama pull gpt-oss:20b` on the Ollama machine first.
OLLAMA_MODEL=gpt-oss:20b
LLM_TEMPERATURE=0.7
