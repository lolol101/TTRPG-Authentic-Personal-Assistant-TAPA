# OpenAI-compatible endpoint. Ollama (local, GPU) and OpenRouter (cloud) both
# speak this API — swap these three values, no code changes needed.

# Local Ollama, current default (needs a GPU-capable machine):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:14b

# OpenRouter instead (get a free key at https://openrouter.ai/keys):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-api-key
# LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Embeddings: "ollama" runs on the GPU, "fastembed" is the CPU-only fallback.
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL_ID=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_BACKEND=fastembed
# EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Each embedding model has its own vector space — give each its own collection.
CHROMA_COLLECTION=pf2e_actions_ru_bge_m3
