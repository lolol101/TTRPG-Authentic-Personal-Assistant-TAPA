DATABASE_URL=sqlite:///./data/dev.db

# Обязателен. Без него приложение не стартует — и это намеренно:
# ключ-заглушка в репозитории означает, что любой, кто видел код,
# подделает токен любого пользователя.
#
# Сгенерировать свой:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LLM_SERVICE_URL=http://localhost:8100

# When the checker rejects part of a sheet proposal, send the result back to
# the model for one corrected attempt instead of just showing the player a
# list of unavailable paths. Costs one extra call to llm-service, only when
# there was something to correct.
SHEET_EDIT_RETRY=true

# Собранный фронтенд, который бэкенд раздаёт в корне. Пусто — берётся
# apps/web-frontend/dist рядом с репозиторием. Сборки нет — только API.
FRONTEND_DIST_DIR=
