DATABASE_URL=sqlite:///./data/dev.db

# Обязателен. Без него приложение не стартует — и это намеренно:
# ключ-заглушка в репозитории означает, что любой, кто видел код,
# подделает токен любого пользователя.
#
# Сгенерировать свой:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LLM_SERVICE_URL=http://localhost:8100
